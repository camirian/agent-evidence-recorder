  "schema_version": "agent_evidence_recorder.public_sample.v0",
  "tool_or_model_steps": [
    {
      "adapter": "synthetic_sample",
      "changed_files": [
        "network_plan.txt"
      ],
      "live_model_used": false,
      "step": "modeled_agent_edit"
    },
    {
      "command": [
        "agent_evidence-recorder",
        "simulate-live-envelope-preflight"
      ],
      "cwd": "samples",
      "returncode": 0,
      "stderr_summary": "",
      "stdout_summary": "provider request blocked during preflight"
    }
  ],
  "verification_notes": {
    "human_escalation_record": "samples/agent_evidence-sample-run-live-envelope/human_escalation_record.json",
    "policy_gate_report": "samples/agent_evidence-sample-run-live-envelope/policy_gate_report.json",
    "public_surface": "relative_paths_only",
    "residual_risk": "sample_does_not_wrap_live_agents",
    "sample_verification": "samples/agent_evidence-sample-run-live-envelope/sample_verification.json"
  },
  "workflow_type": "live_preflight_envelope"
}
