      "relative_path": "samples/agent_evidence-sample-run-live-envelope/policy_gate_report.json"
    },
    {
      "artifact_role": "human_escalation_record",
      "relative_path": "samples/agent_evidence-sample-run-live-envelope/human_escalation_record.json"
    },
    {
      "artifact_role": "loop_stage_summary",
      "relative_path": "samples/agent_evidence-sample-run-live-envelope/loop_stage_summary.json"
    },
    {
      "artifact_role": "kill_switch_boundary",
      "relative_path": "samples/agent_evidence-sample-run-live-envelope/kill_switch_boundary.md"
    },
    {
      "artifact_role": "evidence_packet",
      "relative_path": "samples/agent_evidence-sample-run-live-envelope/evidence_packet.md"
    },
    {
      "artifact_role": "review_packet",
      "relative_path": "samples/agent_evidence-sample-run-live-envelope/review_packet.md"
    },
    {
      "artifact_role": "rollback_script",
      "relative_path": "samples/agent_evidence-sample-run-live-envelope/rollback.sh"
